# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# https://steamcommunity.com/dev/apikey (needed for /steam link)
STEAM_API_KEY=

# Servers allowed to use the bot, comma-separated (right-click server -> Copy Server ID).
# Leave empty to allow any server that adds it. The bot leaves servers that aren't listed.
ALLOWED_GUILD_IDS=

# How often Steam prices are checked (one check covers every server)
# SALE_CHECK_HOURS=6

# Turns on the management API, for the web UI. Any long random value. Never publish API_PORT;
# only other containers should reach it
# API_TOKEN=

# The voice container, for text to speech. Unset turns /say off
# VOICE_URL=http://voice:5000
# API_PORT=8787

# The container's time zone; also every server's default time zone
TZ=America/Chicago

# Everything else is set per server in Discord with /setup. These only change the default
# for servers that haven't set their own (built-in defaults shown):
# HOPON_MIN_PEOPLE=2
# HOPON_COOLDOWN_MIN=120
# RECAP_MIN_MINUTES=15
# SESSION_GRACE_MIN=5
# WEEKLY_POST_DAY=0   # 0 = Sunday
# WEEKLY_POST_HOUR=20
# STEAM_CC=us
# SALE_MIN_DISCOUNT=25
# SALE_STEAM_WISHLISTS=true
# STEAM_STATUS=true
# PATCH_NOTES=off   # off, each or digest
# FREE_GAMES=false
# GAMENIGHT_REMINDER_MIN=15
# MONTHLY_RECAP=true
# EVEN_VOLUME=true
# JOIN_SOUNDS=true
# JOIN_SOUND_COOLDOWN_MIN=10
# JOIN_SOUND_DELAY_MS=500
# TTS=true
# TTS_MAX_CHARS=200
# TTS_COOLDOWN_SEC=5
# TTS_VOICE=5   # 1, 2, 5 or 9
# TTS_SPEED=85   # percent of the voice's natural speed
