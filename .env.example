# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click server / channel / role -> Copy ID (enable Developer Mode in Discord settings)
GUILD_ID=
ANNOUNCE_CHANNEL_ID=
# Role that gets pinged by hop-on alerts; people opt in with /notify
HOPON_ROLE_ID=

# https://steamcommunity.com/dev/apikey (needed for /steam link)
STEAM_API_KEY=

# Optional tuning (defaults shown)
# HOPON_MIN_PEOPLE=2
# HOPON_COOLDOWN_MIN=120
# RECAP_MIN_MINUTES=15
# SESSION_GRACE_MIN=5
# SALE_CHECK_HOURS=6
# STEAM_CC=us
# WEEKLY_POST_DAY=0   # 0 = Sunday
# WEEKLY_POST_HOUR=20
TZ=America/Chicago
