# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# https://steamcommunity.com/dev/apikey (needed for /steam link)
STEAM_API_KEY=

# Servers allowed to use the bot, comma-separated (right-click server -> Copy Server ID).
# Leave empty to allow any server that adds it. The bot leaves servers that aren't listed.
ALLOWED_GUILD_IDS=

# How often Steam prices are checked (one check covers every server)
# SALE_CHECK_HOURS=6

# Turns on the management API, for the web UI. Any long random value. Never publish API_PORT;
# only other containers should reach it
# API_TOKEN=
# The web UI container's password, read by its service in docker-compose.yml
# WEB_PASSWORD=

# The voice container, for text to speech. Unset turns /say off
# VOICE_URL=http://voice:5000
# Set on the voice container, not the bot: minutes before a model other than the default one that hasn't spoken is let go, 0 to keep every model loaded
# VOICE_IDLE_MINUTES=30
# API_PORT=8787

# The loop bot, a second bot that plays the looping room. See the README's loop bot section. Unset plays the room on this bot
# LOOP_BOT_URL=http://loop:8788
# LOOP_TOKEN=   # any long random value; the loop bot gets the same
# LOOP_BOT_TOKEN=   # the loop bot's own Discord token, for its container only

# Music, through the music container. See the README's music container section first: Spotify's terms apply
# MUSIC_URL=http://music:7700
# MUSIC_TOKEN=   # any long random value; the music container gets the same
# MUSIC_CACHE_MB=1024   # how much downloaded music the music container keeps
# MUSIC_AUDIO_DIR=/music/audio   # where the bot reads it, from the music container's volume
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=   # for the account's own playlists, from `node src/spotify-sign-in.ts`
# SPOTIFY_MARKET=US

# The container's time zone; also every server's default time zone
TZ=America/Chicago

# Everything else is set per server in Discord with /setup. These only change the default
# for servers that haven't set their own (built-in defaults shown):
# HOPON_MIN_PEOPLE=2
# HOPON_COOLDOWN_MIN=120
# SESSION_RECAP=true
# RECAP_MIN_MINUTES=15
# SESSION_GRACE_MIN=5
# WEEKLY_LEADERBOARD=true
# WEEKLY_POST_DAY=0   # 0 = Sunday
# WEEKLY_POST_HOUR=20
# STEAM_CC=us
# SALE_MIN_DISCOUNT=25
# SALE_STEAM_WISHLISTS=true
# STEAM_STATUS=true
# PATCH_NOTES=off   # off, each or digest
# FREE_GAMES=false
# FREE_GAMES_MIN_RATING=70   # lowest Steam rating, as a percentage positive
# FREE_GAMES_TASTE=true   # only games like what the server plays
# FREE_GAMES_MULTIPLAYER=false
# FREE_GAMES_UNLISTED=false   # true shows games that aren't on Steam
# GAMENIGHT_REMINDER_MIN=15
# MONTHLY_RECAP=true
# EVEN_VOLUME=true
# JOIN_SOUNDS=true
# JOIN_SOUND_COOLDOWN_MIN=10
# JOIN_SOUND_DELAY_MS=500
# SOUND_VOLUME=100   # percent, for every sound
# LOOP_VOLUME=50   # percent, for the looping sound room
# LOOP_EVERY=0   # seconds between layered copies of the looping sound, like 0.5; 0 loops it without a gap
# LOOP_TEXT_EVERY=0   # seconds between layered copies of the looping speech; 0 says it again straight away
# LOOP_INTRO_DELAY_MS=250   # how long after someone comes in the loop room's intro plays
# LOOP_TEXT_VOLUME=50   # the looping speech's volume, apart from LOOP_VOLUME for the sound
# LOOP_SOUND_DELAY_MS=0   # how long the looping sound waits after the intro
# LOOP_TEXT_DELAY_MS=0   # how long the looping speech waits after the intro
# MUSIC_VOLUME=40   # percent
# TTS=true
# TTS_MAX_CHARS=200
# TTS_COOLDOWN_SEC=5
# TTS_VOICE=tiktok   # a voice's id from VOICES in src/features/say.ts, like glados, russian or demon
# TTS_SPEED=85   # percent of the voice's natural speed
# TTS_VOLUME=100   # 100 is about as loud as a sound
# TTS_CHANNEL_WHO=everyone   # everyone or voice
# TTS_GREET=false   # say who joined voice
# TTS_GREETING={name} joined
# TTS_NIGHT_REMINDERS=false   # say game night reminders in voice
# TTS_HOP_ON=false   # say hop-on pings in voice
