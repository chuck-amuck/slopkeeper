# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# https://steamcommunity.com/dev/apikey (needed for /steam link)
STEAM_API_KEY=

# Servers allowed to use the bot, comma-separated (right-click server -> Copy Server ID).
# Leave empty to allow any server that adds it. The bot leaves servers that aren't listed.
ALLOWED_GUILD_IDS=

# The announce channel and hop-on role are set per server in Discord with /setup.

# Optional tuning (defaults shown)
# HOPON_MIN_PEOPLE=2
# HOPON_COOLDOWN_MIN=120
# RECAP_MIN_MINUTES=15
# SESSION_GRACE_MIN=5
# SALE_CHECK_HOURS=6
# STEAM_CC=us
# WEEKLY_POST_DAY=0   # 0 = Sunday
# WEEKLY_POST_HOUR=20
TZ=America/Chicago
